      "text": "public static void main(String[] args) {\n\n   HashMap<Integer, String> passportsAndNames = new HashMap<>();\n\n}\n\npublic class Main {\n\n   public static void main(String[] args) {\n       HashMap<Integer, String> passportsAndNames = new HashMap<>();\n\n\n       passportsAndNames.put(212133, \"Лидия Аркадьевна Бубликова\");\n       passportsAndNames.put(162348, \"Иван Михайлович Серебряков\");\n       passportsAndNames.put(8082771, \"Дональд Джон Трамп\");\n       System.out.println(passportsAndNames);\n    passportsAndNames.remove(162348);\n\n   }\n\n}\n\ntoString() - {212133=Лидия Аркадьевна Бубликова, 8082771=Дональд Джон Трамп, 162348=Иван Михайлович Серебряков} ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static void main(String[] args) {\n\n   HashMap<Integer, String> passportsAndNames = new HashMap<>();\n\n}\n\npublic class Main {\n\n   public static void main(String[] args) {\n       HashMap<Integer, String> passportsAndNames = new HashMap<>();\n\n\n       passportsAndNames.put(212133, \"Лидия Аркадьевна Бубликова\");\n       passportsAndNames.put(162348, \"Иван Михайлович Серебряков\");\n       passportsAndNames.put(8082771, \"Дональд Джон Трамп\");\n       System.out.println(passportsAndNames);\n    passportsAndNames.remove(162348);\n\n   }\n\n}\n\ntoString() - {212133=Лидия Аркадьевна Бубликова, 8082771=Дональд Джон Трамп, 162348=Иван Михайлович Серебряков} ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Bo3yA-tOyFxpsixsU_fxT",
      "type": "text",
      "x": -1616.3534951487502,
      "y": -202.41804546796595,
      "width": 1391.759033203125,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
