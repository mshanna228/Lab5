      "isDeleted": false,
      "boundElements": [],
      "updated": 1778082440852,
      "link": null,
      "locked": false,
      "text": "(Списки): Хранят элементы в порядке добавления, \nдопускают дубликаты.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(Списки): Хранят элементы в порядке добавления, \nдопускают дубликаты.",
      "autoResize": true,
      "lineHeight": 1.25
    },
