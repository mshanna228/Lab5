      "seed": 1294465605,
      "version": 162,
      "versionNonce": 1533206629,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779292344088,
      "link": null,
      "locked": false,
      "text": "Индекс = хэш & (длина_массива - 1)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Индекс = хэш & (длина_массива - 1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bVRdDyzKJUiy_GkoY4IRf",
      "type": "text",
      "x": 3238.9390215464073,
      "y": 934.2118650899419,
      "width": 226.92779541015625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1018233157,
      "version": 137,
      "versionNonce": 1284251243,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779292986414,
      "link": null,
      "locked": false,
      "text": "h - результат key.hashCode()",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "h - результат key.hashCode()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_h7RDmVyLjVFhSgWJFTkV",
      "type": "text",
      "x": 3496.3527056966464,
      "y": 492.3602575158005,
      "width": 309.0458718434286,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 398719499,
      "version": 322,
      "versionNonce": 1657723397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779293942853,
      "link": null,
      "locked": false,
      "text": "1. key -> метод hashCode() -> хэш\n\n2. математическая обработку, чтобы\nизбежать ситуаций, когда младшие биты\nсовпадают, а старшие — нет.\nreturn (key == null) ? 0 : (h =\nkey.hashCode()) ^ (h >>> 16); XOR\n\n3. индекс бакета по формуле\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. key -> метод hashCode() -> хэш\n\n2. математическая обработку, чтобы избежать ситуаций, когда младшие биты совпадают, а старшие — нет.\nreturn (key == null) ? 0 : (h = key.hashCode()) ^ (h >>> 16); XOR\n\n3. индекс бакета по формуле\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
